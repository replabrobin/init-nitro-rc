#!/bin/bash

# sourcing our current rc.conf requires this to be a bash script
. @RCLIBDIR@/functions

mount_fs(){
    findmnt / --options ro &>/dev/null || mount -o remount,ro / || return 1
    return 0
}

# umount_fs(){
#     umount -r -a -t nosysfs,noproc,nodevtmpfs,notmpfs
# }

umount_fs() {
    local mounts=() target fstype opts=()
    findmnt -mrunRo TARGET,FSTYPE,OPTIONS / | {
        while read -r target fstype options; do
            # interpret the ascii chars, such as \x20 (space)
            printf -v target '%b' "$target"
            # match only targeted fstypes
            if [[ $1 && $1 != "$fstype" ]]; then
                stat_busy "Not unmounting $1 fstype='$fstype'"
                continue
            fi

            # do not unmount API filesystems
            #
            if [[ $target = /@(sys|proc|dev|run|tmp) ]] \
                || [[ $target = /@(sys/fs/cgroup|sys/kernel/security) ]] \
                || [[ $target = /@(sys/kernel/debug|sys/kernel/config) ]] \
                || [[ $target = /@(sys/fs/selinux|dev/shm|dev/pts) ]] \
                || [[ $target = /@(proc/sys/fs/binfmt_misc|dev/mqueue) ]] \
                || [[ $target = /@(dev/hugepages|sys/fs/fuse/connections) ]] \
                || [[ $target = /@(sys/firmware) ]]
            then
                stat_busy "Not unmounting $target fstype='$fstype'"
                continue
            fi

            # avoid networked devices
            IFS=, read -ra opts <<< "$options"
            if in_array _netdev "${opts[@]}"; then
                stat_busy "Not unmounting $target fstype='$fstype' opts=${opts[@]}"
                continue
            fi

            mounts=("$target" "${mounts[@]}")
            #echo "mounts --> ${mounts[@]}"
        done

        if (( ${#mounts[*]} )); then
            stat_busy "Unmounting ${mounts[@]}"
            umount -r "${mounts[@]}" || return 1
        fi
        return 0
    }
}

case "$1" in
    (start)
        stat_busy "Mounting filesystems"
        mount_fs || stat_die root
        add_daemon root
        stat_done root
        ;;
    (stop)
        stat_busy "Unmounting filesystems"
        umount_fs || stat_die root
        rm_daemon root
        stat_done root
        ;;
    (*)
        echo "usage: $0 {start|stop}"
        exit 1
        ;;
esac
